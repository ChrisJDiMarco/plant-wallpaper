# Swift Package Manager build artifacts (multi-GB, regenerated by `swift build`)
.build/

# Regenerable scratch: AI staging output, QA renders, debug screenshots, sources
Generated/

# Temporary working files (image review, in-progress asset generation)
tmp/

# macOS
.DS_Store

# Xcode / SwiftPM local state
*.xcodeproj
*.xcworkspace
.swiftpm/
Package.resolved

# Local release config (signing identity + notary profile names — not secret,
# but kept out of the public repo so forks supply their own)
scripts/.release.env
