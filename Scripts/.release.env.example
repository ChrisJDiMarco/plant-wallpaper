# Copy this to scripts/.release.env (gitignored) and fill in your own values.
# These are identifiers, not secrets — the signing key and notary password are
# stored in your macOS Keychain (see docs/RELEASING.md for first-time setup).
export DEVELOPER_ID_APPLICATION="Developer ID Application: YOUR NAME (TEAMID)"
export NOTARYTOOL_PROFILE="your-notary-profile-name"
export GH_REPO="your-github-user/your-repo"
